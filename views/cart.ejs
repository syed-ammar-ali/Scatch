<%- include('./partials/header', { activePage: 'cart'}) %>

<% if (!user.cart || user.cart.length === 0) { %>
  <div class="w-full min-h-[75vh] flex flex-col items-center justify-center text-center px-4">
    <div class="w-24 h-24 bg-zinc-100 rounded-full flex items-center justify-center mb-5 shadow-inner">
      <i class="ri-shopping-bag-3-line text-5xl text-zinc-400"></i>
    </div>
    <h2 class="text-3xl font-bold text-zinc-800 mb-2">Your Cart is Empty</h2>
    <p class="text-zinc-500 max-w-sm mb-6">Looks like you haven't added anything to your cart yet. Explore our collection and find something you love!</p>
    <a href="/shop" class="px-8 py-3 bg-black text-white font-medium rounded-full shadow hover:bg-zinc-800 transition">
      Explore Products
    </a>
  </div>
<% } else { %>
  <div class="w-full min-h-screen flex items-start px-20 py-16 gap-12">
    <!-- Items list -->
    <div class="w-3/5 flex flex-col gap-6">
      <h2 class="text-2xl font-bold text-zinc-800 mb-2">Shopping Cart (<%= user.cart.length %> items)</h2>
      <% user.cart.forEach(function(item) { %>
        <div class="rounded-xl overflow-hidden border border-zinc-200 bg-white shadow-sm flex flex-col">
          <div class="flex justify-center items-center w-full h-64 bg-[<%= item.bgcolor || '#f4f4f5' %>]">
            <% if (item.image) { %>
              <img
                class="h-4/5 object-contain"
                src="data:image/jpeg;base64, <%= item.image.toString('base64') %>"
                alt="<%= item.name %>"
              />
            <% } %>
          </div>
          <div class="w-full flex justify-between items-center px-6 py-4 bg-[<%= item.panelcolor || '#ffffff' %>]">
            <div>
              <h3 class="text-2xl font-semibold"><%= item.name %></h3>
              <p class="text-sm opacity-70">Price: ₹ <%= item.price %> <% if (item.discount > 0) { %> (₹<%= item.discount %> OFF)<% } %></p>
            </div>
            <a
              href="/removefromcart/<%= item._id %>"
              class="px-3 py-1 text-sm bg-red-100 hover:bg-red-200 text-red-700 rounded-md font-medium transition"
            >
              Remove
            </a>
          </div>
          <div class="flex text-white items-center justify-between px-6 py-3 bg-[<%= item.textcolor || '#18181b' %>]">
            <h4 class="text-base">Net Price</h4>
            <h2 class="text-lg font-bold">₹ <%= Number(item.price) - Number(item.discount || 0) %></h2>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Price Breakdown Summary -->
    <div class="w-2/5 sticky top-10 bg-zinc-50 border border-zinc-200 p-8 rounded-xl shadow-sm">
      <h3 class="text-2xl font-bold text-zinc-900 border-b border-zinc-200 pb-4">Order Summary</h3>
      <div class="mt-6 flex flex-col gap-4 text-zinc-700">
        <div class="flex justify-between items-center text-base">
          <span>Total MRP</span>
          <span class="font-medium">₹ <%= totalMRP %></span>
        </div>
        <div class="flex justify-between items-center text-base">
          <span>Discount on MRP</span>
          <span class="text-green-600 font-medium">- ₹ <%= totalDiscount %></span>
        </div>
        <div class="flex justify-between items-center text-base">
          <span>Platform Fee</span>
          <span class="font-medium">₹ <%= platformFee %></span>
        </div>
        <div class="flex justify-between items-center text-base">
          <span>Shipping Fee</span>
          <span class="text-green-600 font-semibold">FREE</span>
        </div>
      </div>

      <div class="w-full h-[1px] bg-zinc-300 my-6"></div>

      <div class="flex justify-between items-center">
        <h3 class="text-xl font-bold text-zinc-900">Total Amount</h3>
        <h3 class="font-bold text-2xl text-green-600">₹ <%= bill %></h3>
      </div>

      <button class="w-full mt-8 py-3.5 bg-black hover:bg-zinc-800 text-white font-semibold rounded-lg shadow transition">
        Proceed to Checkout
      </button>
    </div>
  </div>
<% } %>

<%- include('./partials/footer') %>

