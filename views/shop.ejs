<%- include('./partials/header', { activePage: 'shop' }) %>

<% if(typeof success !== 'undefined' && success && success.length > 0){ %>
<div class="fixed top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-green-500 z-50 shadow-md">
  <span class="inline-block text-white font-medium"> 
    <%= success %> 
  </span>
</div>
<% } %>

<% if(typeof error !== 'undefined' && error && error.length > 0){ %>
<div class="fixed top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-red-500 z-50 shadow-md">
  <span class="inline-block text-white font-medium"> 
    <%= error %> 
  </span>
</div>
<% } %>

<div class="w-full min-h-screen flex items-start p-12">
  <div class="w-1/5 flex flex-col items-start">
    <div class="flex items-center gap-2">
      <h3 class="font-medium">Sort by:</h3>
      <form action="/shop" method="get">
        <select class="border border-zinc-300 rounded px-2 py-1 text-sm bg-white" name="sortby" onchange="this.form.submit()">
          <option value="popular">Popular</option>
          <option value="newest">Newest</option>
        </select>
      </form>
    </div>
    <div class="flex flex-col mt-12 gap-3 text-zinc-600">
      <a class="block w-fit hover:text-black font-medium" href="/shop">All Products</a>
      <a class="block w-fit hover:text-black" href="/shop?sortby=newest">New Arrivals</a>
    </div>
  </div>
  <div class="w-4/5 flex flex-wrap gap-7">
    <% if (!products || products.length === 0) { %>
      <div class="w-full py-20 flex flex-col items-center justify-center text-center">
        <i class="ri-store-2-line text-5xl text-zinc-300 mb-3"></i>
        <h3 class="text-xl font-semibold text-zinc-700">No Products Found</h3>
        <p class="text-zinc-500 text-sm mt-1">Check back soon for new arrivals!</p>
      </div>
    <% } else { %>
      <div class="flex items-start gap-7 flex-wrap">
        <% products.forEach(function(product){ %>
        <div class="w-60 rounded-lg overflow-hidden border border-zinc-200 shadow-sm flex flex-col bg-white">
          <div
            class="w-full h-52 flex overflow-hidden items-center justify-center bg-[<%= product.bgcolor || '#f4f4f5' %>]"
          >
            <% if (product.image) { %>
              <img
                class="w-4/5 h-4/5 object-contain"
                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                alt="<%= product.name %>"
              />
            <% } %>
          </div>
          <div
            class="flex justify-between items-center px-4 py-4 bg-[<%= product.panelcolor || '#ffffff' %>] text-[<%= product.textcolor || '#000000' %>]"
          >
            <div>
              <h3 class="font-semibold text-base"><%= product.name %></h3>
              <h4 class="text-sm font-medium opacity-80">₹ <%= product.price %></h4>
            </div>
            <a
              class="w-8 h-8 flex items-center justify-center rounded-full bg-black text-white hover:bg-zinc-800 shadow transition"
              href="/addtocart/<%= product._id %>"
              title="Add to cart"
            >
              <i class="ri-add-line text-lg"></i>
            </a>
          </div>
        </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%- include('./partials/footer') %>
