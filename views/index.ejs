<%- include('./partials/header', { loggedIn: false, activePage: 'home' }) %> 

<% if(typeof error !== 'undefined' && error && error.length > 0){ %>
<div
  class="fixed top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-red-500 z-50 shadow-md"
>
  <span class="inline-block text-white font-medium"> <%= error %> </span>
</div>
<% } %>

<% if(typeof success !== 'undefined' && success && success.length > 0){ %>
<div
  class="fixed top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-green-500 z-50 shadow-md"
>
  <span class="inline-block text-white font-medium"> <%= success %> </span>
</div>
<% } %>

<div class="w-full h-screen justify-around flex px-20">
  <div class="w-1/3 flex items-center justify-center h-screen">
    <div class="w-full">
      <h3 class="text-4xl mb-1">
        Welcome to <span class="text-green-500 font-semibold">SCATCH</span>
      </h3>
      <h4 class="capitalize text-2xl mb-5">create your account</h4>
      <form autocomplete="off" action="/users/register" method="post">
        <input
          class="bg-zinc-100 block w-11/12 px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="text"
          placeholder="Full Name"
          name="fullname"
        />
        <input
          class="bg-zinc-100 block w-11/12 px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="email"
          placeholder="Email"
          name="email"
        />
        <input
          class="bg-zinc-100 block w-11/12 px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="password"
          placeholder="Password"
          name="password"
        />
        <input
          class="px-5 rounded-full py-3 mt-3 bg-green-500 font-semibold text-white"
          type="submit"
          value="Create"
        />
      </form>
    </div>
  </div>
  <div
    class="flex items-center justify-center h-screen text-zinc-700 text-xl font-semibold"
  >
    OR
  </div>
  <div class="w-1/3 flex items-center justify-center h-screen">
    <div class="w-full px-">
      <h4 class="text-2xl capitalize mb-5">login your account</h4>
      <form autocomplete="off" action="/users/login" method="post">
        <input
          class="block bg-zinc-100 w-11/12 px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="email"
          placeholder="Email"
          name="email"
        />
        <input
          class="block bg-zinc-100 w-11/12 px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="password"
          placeholder="Password"
          name="password"
        />
        <input
          class="px-5 block rounded-full py-3 mt-5 bg-blue-500 font-semibold text-white"
          type="submit"
          value="Login"
        />
      </form>
    </div>
  </div>
  <div
    class="fixed bottom-6 right-6 bg-zinc-900 hover:bg-black px-4 py-2 rounded-full font-medium shadow-lg transition"
  >
    <a href="/owners/login" class="text-white text-xs tracking-wide">Owner Portal &rarr;</a>
  </div>
</div>

<%- include('./partials/footer') %>
